---
import Layout from '../layouts/Layout.astro';

const stackGroups = [
  {
    kicker: 'Frontend',
    title: 'Blazor WebAssembly',
    body: 'Interfaces SPA con experiencia casi nativa en el navegador, usando componentes Radzen.',
    icon: '<svg width="20" height="20" viewBox="0 0 256 256" fill="currentColor"><path d="M208,40H48A16,16,0,0,0,32,56V200a16,16,0,0,0,16,16H208a16,16,0,0,0,16-16V56A16,16,0,0,0,208,40ZM48,56H208V88H48ZM48,200V104H208v96Z"/></svg>',
  },
  {
    kicker: 'Backend',
    title: 'C# · ASP.NET Core',
    body: 'Arquitecturas limpias y APIs robustas para sostener la lógica de negocio.',
    icon: '<svg width="20" height="20" viewBox="0 0 256 256" fill="currentColor"><path d="M216,80H40A16,16,0,0,0,24,96v40a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V96A16,16,0,0,0,216,80Zm0,56H40V96H216ZM216,168H40a16,16,0,0,0-16,16v40a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V184A16,16,0,0,0,216,168Zm0,56H40V184H216Z"/></svg>',
  },
  {
    kicker: 'Base de datos',
    title: 'SQL Server',
    body: 'Diseño de esquemas, procedimientos almacenados y consultas optimizadas.',
    icon: '<svg width="20" height="20" viewBox="0 0 256 256" fill="currentColor"><path d="M128,24C74.17,24,32,48.6,32,80v96c0,31.4,42.17,56,96,56s96-24.6,96-56V80C224,48.6,181.83,24,128,24Zm80,152c0,16.5-32.66,40-80,40s-80-23.5-80-40V152.9c17.9,15.1,46.2,23.1,80,23.1s62.1-8,80-23.1Z"/></svg>',
  },
  {
    kicker: 'Frontend multiplataforma',
    title: 'React · Vue · Angular',
    body: 'Alternativas de frontend web cuando el proyecto no requiere una SPA en Blazor.',
    icon: '<svg width="20" height="20" viewBox="0 0 256 256" fill="currentColor"><path d="M128,24A104,104,0,1,0,232,128,104.12,104.12,0,0,0,128,24Zm88,104a88.4,88.4,0,0,1-3.29,23.83l-25-4.31a103.4,103.4,0,0,0,0-39l25-4.31A88.4,88.4,0,0,1,216,128Z"/></svg>',
  },
  {
    kicker: 'Apps móviles',
    title: 'Flutter · React Native',
    body: 'Aplicaciones para iOS y Android a partir de una sola base de código, conectadas al mismo backend en C#.',
    icon: '<svg width="20" height="20" viewBox="0 0 256 256" fill="currentColor"><path d="M176,16H80A24,24,0,0,0,56,40V216a24,24,0,0,0,24,24h96a24,24,0,0,0,24-24V40A24,24,0,0,0,176,16Zm8,200a8,8,0,0,1-8,8H80a8,8,0,0,1-8-8V40a8,8,0,0,1,8-8h96a8,8,0,0,1,8,8Z"/></svg>',
  },
  {
    kicker: 'Otros',
    title: 'Acceso y control de versiones',
    body: 'Autenticación y permisos por rol, con flujo de trabajo versionado en Git.',
    icon: '<svg width="20" height="20" viewBox="0 0 256 256" fill="currentColor"><path d="M208,88a32,32,0,1,0-40,31v27a8,8,0,0,1-8,8H96a8,8,0,0,1-8-8v-27a32,32,0,1,0-16,0v27a24,24,0,0,0,24,24h64a24,24,0,0,0,24-24V119A32,32,0,0,0,208,88Z"/></svg>',
  },
];

const values = [
  {
    n: '01',
    title: 'Entender antes de construir',
    body: 'Cada proyecto empieza con preguntas sobre el proceso real, no solo con el pedido.',
    icon: '<svg width="20" height="20" viewBox="0 0 256 256" fill="currentColor"><path d="M176,232a8,8,0,0,1-8,8H88a8,8,0,0,1,0-16h80A8,8,0,0,1,176,232Zm40-128a87.71,87.71,0,0,1-33.6,69.11A8,8,0,0,0,180,180v16a16,16,0,0,1-16,16H92a16,16,0,0,1-16-16V180a8,8,0,0,0-2.4-6.89A88,88,0,1,1,216,104Z"/></svg>',
  },
  {
    n: '02',
    title: 'Arquitectura simple',
    body: 'Prefiero soluciones mantenibles a soluciones innecesariamente complejas.',
    icon: '<svg width="20" height="20" viewBox="0 0 256 256" fill="currentColor"><path d="M223.68,66.15,135.68,18a16,16,0,0,0-15.36,0l-88,48.17a16,16,0,0,0-8.32,14v95.64a16,16,0,0,0,8.32,14l88,48.17a16,16,0,0,0,15.36,0l88-48.17a16,16,0,0,0,8.32-14V80.18A16,16,0,0,0,223.68,66.15Z"/></svg>',
  },
  {
    n: '03',
    title: 'Iteración visible',
    body: 'Revisas avances reales del sistema durante el desarrollo, no solo al final.',
    icon: '<svg width="20" height="20" viewBox="0 0 256 256" fill="currentColor"><path d="M247.31,124.76c-.35-.79-8.82-19.58-27.65-38.41C194.57,61.26,162.88,48,128,48S61.43,61.26,36.34,86.35C17.51,105.18,9,124,8.69,124.76a8,8,0,0,0,0,6.5c.35.79,8.82,19.57,27.65,38.4C61.43,194.74,93.12,208,128,208s66.57-13.26,91.66-38.34c18.83-18.83,27.3-37.61,27.65-38.4A8,8,0,0,0,247.31,124.76ZM128,168a40,40,0,1,1,40-40A40,40,0,0,1,128,168Z"/></svg>',
  },
  {
    n: '04',
    title: 'Compromiso después de la entrega',
    body: 'Sigo disponible para ajustes cuando el sistema ya está en producción.',
    icon: '<svg width="20" height="20" viewBox="0 0 256 256" fill="currentColor"><path d="M128,24A88.1,88.1,0,0,0,40,112v56a24,24,0,0,0,24,24H80a8,8,0,0,0,8-8V136a8,8,0,0,0-8-8H56v-16a72,72,0,0,1,144,0v16H176a8,8,0,0,0-8,8v48a8,8,0,0,0,8,8h16a24,24,0,0,0,24-24V112A88.1,88.1,0,0,0,128,24Z"/></svg>',
  },
];
---
<Layout title="Sobre mí — ZA Desarrollo Software">
  <main>
    <section class="wrap" style="padding-block: 28px 32px">
      <div class="stack-mobile" style="display: grid; grid-template-columns: minmax(0,1.2fr) minmax(0,1fr); gap: 40px; align-items: center; border: 1px solid color-mix(in srgb, var(--color-text) 8%, transparent); border-left: 2px solid var(--color-accent); border-radius: var(--radius-md); padding: clamp(20px,3.2vw,36px)">
        <div>
          <span style="display: block; font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent); margin-bottom: 18px">Sobre mí</span>
          <h1 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: clamp(28px,4vw,40px); margin: 0; max-width: 22ch">Ing. Jassiel Zamarrón — desarrollador full-stack de sistemas de negocio.</h1>
          <p style="font-size: 15.5px; line-height: 1.7; color: color-mix(in srgb, var(--color-text) 80%, transparent); max-width: 54ch; margin: 24px 0 0">Me dedico al desarrollo de software a medida para empresas que necesitan herramientas internas confiables: portales de gestión, sistemas de inventario, aplicaciones móviles y plataformas administrativas con control de acceso. Trabajo de forma independiente bajo ZA Desarrollo Software, encargándome del proyecto de punta a punta — desde entender el proceso que hay que resolver hasta la puesta en producción del sistema.</p>
        </div>
        <div style="width: 100%; aspect-ratio: 4/5; border-radius: var(--radius-md); overflow: hidden">
          <img src="/images/architecture-layers.jpg" alt="Capas de arquitectura: interfaz, API y base de datos" class="img-cover" />
        </div>
      </div>
    </section>

    <section style="background: var(--color-surface)">
      <div data-reveal="1" class="wrap" style="padding-block: 56px">
        <h2 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: clamp(22px,2.6vw,28px); margin: 0 0 28px">Stack que domino</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(220px,100%),1fr)); gap: 16px">
          {stackGroups.map((g) => (
            <div class="card" style="background: var(--color-bg)">
              <div style="width: 40px; height: 40px; border-radius: var(--radius-md); background: color-mix(in srgb, var(--color-accent) 14%, transparent); display: flex; align-items: center; justify-content: center; color: var(--color-accent); margin-bottom: 4px" set:html={g.icon} />
              <span class="card-kicker">{g.kicker}</span>
              <h3 class="card-title">{g.title}</h3>
              <p class="card-body" style="opacity: 1; color: color-mix(in srgb, var(--color-text) 72%, transparent)">{g.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section style="background: var(--color-section)">
      <div data-reveal="1" class="wrap" style="padding-block: 56px 96px">
        <h2 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: clamp(22px,2.6vw,28px); margin: 0 0 28px">Forma de trabajo</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px,100%),1fr)); gap: 24px 32px; margin-bottom: 40px">
          {values.map((v) => (
            <div style="padding: 20px 0; border-top: 1px solid var(--color-divider)">
              <div style="width: 40px; height: 40px; border-radius: var(--radius-md); background: color-mix(in srgb, var(--color-accent) 14%, transparent); display: flex; align-items: center; justify-content: center; color: var(--color-accent); margin-bottom: 12px" set:html={v.icon} />
              <span style="display: block; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-accent); margin-bottom: 8px">{v.n}</span>
              <h3 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: 18px; margin: 0 0 8px">{v.title}</h3>
              <p style="font-size: 15px; line-height: 1.6; color: color-mix(in srgb, var(--color-text) 70%, transparent); margin: 0">{v.body}</p>
            </div>
          ))}
        </div>
        <div class="card" style="flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; background: var(--color-bg)">
          <p style="margin: 0; font-size: 15px; color: color-mix(in srgb, var(--color-text) 85%, transparent); max-width: 40ch">¿Buscas a alguien que se haga cargo del proyecto completo?</p>
          <a href="/contacto" class="btn btn-primary" style="white-space: nowrap">Hablemos</a>
        </div>
      </div>
    </section>
  </main>
</Layout>
