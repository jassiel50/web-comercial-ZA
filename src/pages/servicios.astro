---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    title: 'Sistemas administrativos y ERP',
    body: 'Control de ventas, clientes, inventarios, empleados y seguimiento de proyectos en un solo panel.',
    icon: '<svg width="22" height="22" viewBox="0 0 256 256" fill="currentColor"><path d="M128,24C74.17,24,32,48.6,32,80v96c0,31.4,42.17,56,96,56s96-24.6,96-56V80C224,48.6,181.83,24,128,24Zm80,104c0,16.5-32.66,40-80,40s-80-23.5-80-40V152.9c17.9,15.1,46.2,23.1,80,23.1s62.1-8,80-23.1Zm-80,8c-47.34,0-80-23.5-80-40V96.9c17.9,15.1,46.2,23.1,80,23.1s62.1-8,80-23.1V96C208,112.5,175.34,136,128,136ZM128,104C80.66,104,48,80.5,48,64s32.66-40,80-40,80,23.5,80,40S175.34,104,128,104Z"/></svg>',
    stack: ['Blazor WebAssembly', 'C#', 'SQL Server'],
  },
  {
    title: 'Portales de gestión',
    body: 'Portales con acceso diferenciado para clientes, proveedores o equipos, con autenticación y permisos por rol.',
    icon: '<svg width="22" height="22" viewBox="0 0 256 256" fill="currentColor"><path d="M208,80H72V56a56,56,0,0,1,112,0,8,8,0,0,0,16,0,72,72,0,0,0-144,0V80H48A16,16,0,0,0,32,96V208a16,16,0,0,0,16,16H208a16,16,0,0,0,16-16V96A16,16,0,0,0,208,80Zm0,128H48V96H208V208Z"/></svg>',
    stack: ['Blazor WebAssembly', 'ASP.NET Core Identity', 'SQL Server'],
  },
  {
    title: 'Aplicaciones móviles',
    body: 'Apps multiplataforma para iOS y Android que extienden tu sistema al celular de tu equipo o de tus clientes.',
    icon: '<svg width="22" height="22" viewBox="0 0 256 256" fill="currentColor"><path d="M176,16H80A24,24,0,0,0,56,40V216a24,24,0,0,0,24,24h96a24,24,0,0,0,24-24V40A24,24,0,0,0,176,16Zm8,200a8,8,0,0,1-8,8H80a8,8,0,0,1-8-8V40a8,8,0,0,1,8-8h96a8,8,0,0,1,8,8ZM140,184a12,12,0,1,1-12-12A12,12,0,0,1,140,184Z"/></svg>',
    stack: ['Flutter', 'React Native', 'iOS', 'Android'],
    platforms: true,
  },
  {
    title: 'Páginas web y sistemas web',
    body: 'Sitios y sistemas web con tu imagen de marca — logo, colores y estilo propios.',
    icon: '<svg width="22" height="22" viewBox="0 0 256 256" fill="currentColor"><path d="M128,24A104,104,0,1,0,232,128,104.12,104.12,0,0,0,128,24Zm88,104a88.4,88.4,0,0,1-3.29,23.83l-25-4.31a103.4,103.4,0,0,0,0-39l25-4.31A88.4,88.4,0,0,1,216,128ZM128,216a87.9,87.9,0,0,1-19.14-2.13c5.6-9.68,12.4-23.86,17.14-42.19,4.74,18.33,11.54,32.51,17.14,42.19A87.9,87.9,0,0,1,128,216Zm0-160a87.9,87.9,0,0,1,19.14,2.13c-5.6,9.68-12.4,23.86-17.14,42.19-4.74-18.33-11.54-32.51-17.14-42.19A87.9,87.9,0,0,1,128,56ZM40,128a88.4,88.4,0,0,1,3.29-23.83l25,4.31a103.4,103.4,0,0,0,0,39l-25,4.31A88.4,88.4,0,0,1,40,128Z"/></svg>',
    stack: ['Blazor WebAssembly', 'React', 'Vue', 'Angular'],
  },
  {
    title: 'Automatización y herramientas a la medida',
    body: 'Cotizadores, calculadoras, buscadores y flujos que reemplazan tareas manuales repetitivas.',
    icon: '<svg width="22" height="22" viewBox="0 0 256 256" fill="currentColor"><path d="M226.53,56.41a8,8,0,0,0-9-1.41l-40,20a8,8,0,0,0-4.41,7.14v33.72L104,148.56V88a8,8,0,0,0-4.41-7.14l-64-32a8,8,0,0,0-11.18,10.7L32,66.94v122.1l-7.59,3.8a8,8,0,0,0,3.18,15.32,7.9,7.9,0,0,0,3.58-.86l64-32A8,8,0,0,0,100,168V107.44l69.12-34.56L232,105.06,169.12,136.5l-8.53-4.27a8,8,0,0,0-7.16,14.31l64,32A8,8,0,0,0,224,176V85.72l7.59-3.8A8,8,0,0,0,226.53,56.41ZM48,177.06V79.94l48,24v97.12ZM208,163.06l-48-24V90.94l48-24Z"/></svg>',
    stack: ['C#', 'SQL Server', 'Radzen'],
  },
  {
    title: 'Implementaciones en la nube',
    body: 'Despliegue en Azure con acceso en línea, o uso local si el negocio lo prefiere — incluye integraciones con mapas y geolocalización.',
    icon: '<svg width="22" height="22" viewBox="0 0 256 256" fill="currentColor"><path d="M160,40A88.09,88.09,0,0,0,81.29,88.68,64,64,0,1,0,72,216h88a88,88,0,0,0,0-176Zm0,160H72a48,48,0,0,1,0-96c1.1,0,2.2,0,3.29.11A88,88,0,0,0,72,128a8,8,0,0,0,16,0,72,72,0,1,1,72,72Z"/></svg>',
    stack: ['Azure', 'Maps'],
  },
];

const steps = [
  { n: '01', title: 'Diagnóstico', body: 'Conversamos sobre el proceso o problema actual, sin compromiso.' },
  { n: '02', title: 'Cotización', body: 'Defino alcance, tiempos y stack técnico antes de empezar — sin compromiso.' },
  { n: '03', title: 'Desarrollo', body: 'Construyo el sistema en iteraciones que puedes revisar en el camino.' },
  { n: '04', title: 'Entrega', body: 'Despliegue del sistema y traspaso de documentación técnica.' },
  { n: '05', title: 'Soporte', body: 'Acompañamiento posterior para ajustes y nuevas necesidades.' },
];
---
<Layout title="Servicios — ZA Desarrollo Software">
  <main style="max-width: 1400px; margin: 0 auto; padding: 0 clamp(28px,6vw,64px)">
    <section class="stack-mobile" style="padding: 32px 0 24px; display: grid; grid-template-columns: minmax(0,1.1fr) minmax(0,1fr); gap: 40px; align-items: center">
      <div>
        <span style="display: block; font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent); margin-bottom: 18px">Servicios</span>
        <h1 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: clamp(28px,4.4vw,42px); margin: 0; max-width: 16ch">Qué tipo de proyectos tomo.</h1>
        <p style="font-size: 16px; line-height: 1.7; color: color-mix(in srgb, var(--color-text) 78%, transparent); max-width: 56ch; margin: 20px 0 0">Trabajo con empresas que necesitan reemplazar procesos manuales o herramientas improvisadas por sistemas propios, construidos a la medida de cómo opera el negocio — desde el sistema web hasta la app móvil que lo acompaña.</p>
      </div>
      <div style="width: 100%; aspect-ratio: 4/3; border-radius: var(--radius-lg); overflow: hidden">
        <img src="/images/server-rack.jpg" alt="Infraestructura del sistema" class="img-cover" />
      </div>
    </section>

    <section data-reveal="1" style="padding: 40px 0 64px">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px,100%),1fr)); gap: 20px">
        {services.map((s) => (
          <div class="card">
            <div style="width: 44px; height: 44px; border-radius: var(--radius-md); background: color-mix(in srgb, var(--color-accent) 14%, transparent); display: flex; align-items: center; justify-content: center; color: var(--color-accent)" set:html={s.icon} />
            <h2 class="card-title" style="margin-top: 6px">{s.title}</h2>
            <p class="card-body" style="opacity: 1; color: color-mix(in srgb, var(--color-text) 75%, transparent)">{s.body}</p>
            {s.platforms && (
              <div style="display: flex; gap: 8px; margin-top: 2px">
                <span style="width: 30px; height: 30px; border-radius: 50%; background: color-mix(in srgb, var(--color-text) 10%, transparent); display: flex; align-items: center; justify-content: center; color: var(--color-text)" title="iOS">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M16.365 1.43c0 1.14-.475 2.15-1.24 2.86-.83.79-2.11 1.4-3.19 1.31-.13-1.11.42-2.28 1.19-3 .84-.8 2.28-1.38 3.24-1.17ZM20.6 17.15c-.44 1.02-.65 1.48-1.22 2.38-.79 1.26-1.9 2.83-3.29 2.84-1.23.02-1.55-.8-3.22-.79-1.67.01-2.02.81-3.25.79-1.39-.02-2.44-1.44-3.23-2.7-2.22-3.53-2.45-7.67-1.08-9.87.97-1.56 2.5-2.47 3.94-2.47 1.46 0 2.38.8 3.59.8 1.17 0 1.89-.8 3.58-.8 1.29 0 2.66.7 3.63 1.91-3.19 1.75-2.68 6.3.55 7.91Z"/></svg>
                </span>
                <span style="width: 30px; height: 30px; border-radius: 50%; background: color-mix(in srgb, #6ee7b7 16%, transparent); display: flex; align-items: center; justify-content: center; color: #6ee7b7" title="Android">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.6 9.48l1.84-3.18a.6.6 0 00-1.04-.6l-1.88 3.24a11.46 11.46 0 00-8.94 0L5.7 5.7a.6.6 0 10-1.04.6l1.84 3.18A10.78 10.78 0 001 18h22a10.78 10.78 0 00-5.4-8.52zM7 15.25a1.25 1.25 0 110-2.5 1.25 1.25 0 010 2.5zm10 0a1.25 1.25 0 110-2.5 1.25 1.25 0 010 2.5z"/></svg>
                </span>
              </div>
            )}
            <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; padding-top: 14px; border-top: 1px solid var(--color-divider)">
              {s.stack.map((t) => (
                <span class="tag tag-neutral" style="font-family: var(--font-mono)">{t}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section data-reveal="1" style="padding: 40px 0 64px; border-top: 1px solid var(--color-divider)">
      <h2 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: clamp(22px,2.6vw,28px); margin: 32px 0 32px">Cómo trabajamos</h2>
      <div style="display: flex; flex-direction: column">
        {steps.map((step) => (
          <div style="display: grid; grid-template-columns: 56px minmax(0,1fr); gap: 20px; padding: 20px 0; border-top: 1px solid var(--color-divider)">
            <span style="font-family: var(--font-mono); font-size: 16px; color: var(--color-accent)">{step.n}</span>
            <div>
              <h3 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: 19px; margin: 0 0 6px">{step.title}</h3>
              <p style="font-size: 15.5px; line-height: 1.6; color: color-mix(in srgb, var(--color-text) 72%, transparent); margin: 0; max-width: 54ch">{step.body}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section style="padding: 0 0 96px">
      <div class="card" style="flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px">
        <p style="margin: 0; font-size: 15px; color: color-mix(in srgb, var(--color-text) 85%, transparent); max-width: 42ch">¿Tienes un proceso o sistema en mente? Conversemos sin compromiso.</p>
        <a href="/contacto" class="btn btn-primary" style="white-space: nowrap">Hablemos</a>
      </div>
    </section>
  </main>
</Layout>
