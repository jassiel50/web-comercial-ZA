---
import Layout from '../layouts/Layout.astro';
import { DEMO_ERP_URL } from '../data/nav';

const heroStats = [
  { label: 'Registro', value: 'No requiere', color: '#6ee7b7' },
  { label: 'Datos', value: '100% de ejemplo', color: '#9184d9' },
  { label: 'Disponibilidad', value: '24/7', color: '#f5b971' },
];

const modules = [
  {
    title: 'Panel',
    body: 'Un vistazo a toda tu operación: ventas del mes, stock bajo, empleados activos — todo en una sola pantalla.',
    color: '#9184d9',
    icon: '<svg width="22" height="22" viewBox="0 0 256 256" fill="currentColor"><path d="M216,40H40A16,16,0,0,0,24,56V200a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V56A16,16,0,0,0,216,40ZM40,56H120V96H40Zm0,56H120v72H40ZM216,200H136V112H216v88Z"/></svg>',
  },
  {
    title: 'Productos',
    body: 'Tu catálogo completo con precios, categorías y estado de stock, siempre actualizado.',
    color: '#6ee7b7',
    icon: '<svg width="22" height="22" viewBox="0 0 256 256" fill="currentColor"><path d="M223.68,66.15,135.68,18a16,16,0,0,0-15.36,0l-88,48.17a16,16,0,0,0-8.32,14v95.64a16,16,0,0,0,8.32,14l88,48.17a16,16,0,0,0,15.36,0l88-48.17a16,16,0,0,0,8.32-14V80.18A16,16,0,0,0,223.68,66.15Z"/></svg>',
  },
  {
    title: 'Inventarios',
    body: 'Cada entrada y salida de almacén queda registrada — sabes exactamente qué tienes y por qué cambió.',
    color: '#f5b971',
    icon: '<svg width="22" height="22" viewBox="0 0 256 256" fill="currentColor"><path d="M232,64H24A8,8,0,0,0,16,72V200a16,16,0,0,0,16,16H224a16,16,0,0,0,16-16V72A8,8,0,0,0,232,64ZM40,80H216V96H40Zm176,120H40V112H216v88Z"/></svg>',
  },
  {
    title: 'Clientes',
    body: 'Tu directorio de clientes con historial y datos de contacto, sin depender de un cuaderno o un Excel.',
    color: '#9184d9',
    icon: '<svg width="22" height="22" viewBox="0 0 256 256" fill="currentColor"><circle cx="88" cy="108" r="52"/><path d="M155.41,57.34a8,8,0,0,1,9.72-5.76,52,52,0,0,1,0,100.84,8,8,0,0,1-9.72-5.76,8,8,0,0,1,5.76-9.72,36,36,0,0,0,0-69.88A8,8,0,0,1,155.41,57.34ZM24,208a72.07,72.07,0,0,1,128-45.32,8,8,0,1,1-12.46,10A56.06,56.06,0,0,0,40,208a8,8,0,0,1-16,0Zm192,0a8,8,0,0,1-16,0,55.94,55.94,0,0,0-32.66-50.9,8,8,0,0,1,6.6-14.58A72,72,0,0,1,216,208Z"/></svg>',
  },
  {
    title: 'Ventas',
    body: 'Registra y da seguimiento a cada pedido, desde que se genera hasta que se cobra.',
    color: '#6ee7b7',
    icon: '<svg width="22" height="22" viewBox="0 0 256 256" fill="currentColor"><path d="M208,80H72V56a56,56,0,0,1,112,0,8,8,0,0,0,16,0,72,72,0,0,0-144,0V80H48A16,16,0,0,0,32,96V208a16,16,0,0,0,16,16H208a16,16,0,0,0,16-16V96A16,16,0,0,0,208,80Zm0,128H48V96H208V208Z"/></svg>',
  },
  {
    title: 'Empleados',
    body: 'Directorio de personal, puestos y nómina — todo en el mismo lugar donde ya administras tu negocio.',
    color: '#f5b971',
    icon: '<svg width="22" height="22" viewBox="0 0 256 256" fill="currentColor"><path d="M230.92,212c-15.23-26.33-38.7-45.21-66.09-54.16a72,72,0,1,0-73.66,0C63.78,166.79,40.31,185.67,25.08,212a8,8,0,1,0,13.85,8c18.84-32.56,52.14-52,89.07-52s70.23,19.44,89.07,52a8,8,0,1,0,13.85-8ZM72,96a56,56,0,1,1,56,56A56.06,56.06,0,0,1,72,96Z"/></svg>',
  },
];

const businessSize = [
  {
    title: 'Si apenas estás creciendo',
    color: '#6ee7b7',
    items: [
      'Deja atrás el Excel y el cuaderno de ventas',
      'Un solo lugar para ver cómo va tu negocio hoy',
      'Empieza con lo básico y agrega módulos cuando los necesites',
    ],
  },
  {
    title: 'Si ya tienes un equipo',
    color: '#9184d9',
    items: [
      'Cada persona ve solo lo que le corresponde, por rol',
      'Reportes en tiempo real para decidir con datos, no a ojo',
      'Se adapta a tus procesos — no tú a los del sistema',
    ],
  },
];
---
<Layout title="Demo en vivo de un ERP — ZA Desarrollo Software" description="Prueba en vivo, sin registro, un ERP real construido por ZA Desarrollo Software: inventario, clientes, ventas y empleados en un solo sistema.">
  <main>

    <section style="position: relative; overflow: hidden; background: radial-gradient(950px 560px at 88% -16%, color-mix(in srgb, var(--color-accent) 22%, transparent), transparent 62%), radial-gradient(720px 460px at 4% 100%, color-mix(in srgb, #6ee7b7 17%, transparent), transparent 65%), var(--color-bg)">
      <div class="wrap" style="padding-block: 40px 56px">
        <div class="stack-mobile" style="display: grid; grid-template-columns: minmax(0,1.05fr) minmax(0,1fr); gap: 48px; align-items: center">
          <div>
            <span style="display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.06em; text-transform: uppercase; color: color-mix(in srgb, var(--color-text) 85%, transparent); background: color-mix(in srgb, var(--color-surface) 70%, transparent); backdrop-filter: blur(10px); border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent); padding: 7px 14px; border-radius: 999px; margin-bottom: 18px">
              <span style="width: 7px; height: 7px; border-radius: 50%; background: #6ee7b7; flex: none; animation: waPulse 2s ease-in-out infinite"></span>
              Demo en vivo · sin registro
            </span>
            <h1 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: clamp(30px,4.2vw,46px); line-height: 1.1; letter-spacing: -0.015em; margin: 0; max-width: 16ch">Un ERP real. Pruébalo ahora, no te lo imagines.</h1>
            <p style="font-size: 16px; line-height: 1.6; color: color-mix(in srgb, var(--color-text) 80%, transparent); max-width: 54ch; margin: 20px 0 0">No es un video ni una maqueta — es el sistema completo, corriendo en este momento. Entra con cualquier usuario y contraseña: los datos son de ejemplo y viven solo en tu sesión.</p>

            <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 14px; margin-top: 28px">
              <a href={DEMO_ERP_URL} target="_blank" rel="noopener" class="btn btn-solid-accent">Probar la demo en vivo →</a>
              <span style="font-family: var(--font-mono); font-size: 11px; font-weight: 700; letter-spacing: 0.06em; color: #161826; background: #f5b971; padding: 6px 12px; border-radius: 999px">DEMO</span>
              <a href="/contacto" class="btn btn-secondary">Quiero uno para mi negocio</a>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(140px,45%),1fr)); gap: 14px; margin-top: 32px">
              {heroStats.map((s) => (
                <div style="padding-left: 16px; border-left: 1px solid var(--color-divider)">
                  <span style="display: block; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: color-mix(in srgb, var(--color-text) 55%, transparent); margin-bottom: 4px">{s.label}</span>
                  <span style={`font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: 17px; color: ${s.color}`}>{s.value}</span>
                </div>
              ))}
            </div>
          </div>

          <div style="position: relative; width: 100%; aspect-ratio: 4/3; overflow: visible">
            <div style="position: relative; width: 100%; height: 100%; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-lg); border: 1px solid var(--color-divider)">
              <div style="background: #1c1e29; padding: 10px 14px; display: flex; align-items: center; gap: 7px">
                <span style="width: 9px; height: 9px; border-radius: 50%; background: #4a4d5c"></span>
                <span style="width: 9px; height: 9px; border-radius: 50%; background: #4a4d5c"></span>
                <span style="width: 9px; height: 9px; border-radius: 50%; background: #4a4d5c"></span>
                <span style="margin-left: 8px; font-family: var(--font-mono); font-size: 10.5px; color: color-mix(in srgb, #e9e9ed 45%, transparent)">zadesarrollo-erp-demo.azurestaticapps.net</span>
              </div>
              <img src="/images/demo-erp-dashboard.png" alt="Panel principal del ERP demo" style="display: block; width: 100%; height: calc(100% - 37px); object-fit: cover; object-position: top" />
            </div>
            <div class="float-slow" style="position: absolute; top: -14px; right: 14px; display: inline-flex; align-items: center; gap: 7px; font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.04em; color: color-mix(in srgb, var(--color-text) 88%, transparent); background: color-mix(in srgb, var(--color-bg) 82%, transparent); backdrop-filter: blur(10px); border: 1px solid color-mix(in srgb, var(--color-text) 14%, transparent); border-radius: 999px; padding: 7px 13px; box-shadow: var(--shadow-md)">
              <span style="width: 6px; height: 6px; border-radius: 50%; background: #6ee7b7; flex: none; animation: waPulse 2s ease-in-out infinite"></span>
              Datos de ejemplo, en vivo
            </div>
          </div>
        </div>
      </div>
    </section>

    <section style="background: var(--color-surface)">
      <div data-reveal="1" class="wrap" style="padding-block: 64px">
        <span style="display: block; font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent); margin-bottom: 14px">Aprende</span>
        <h2 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: clamp(24px,3vw,32px); margin: 0 0 20px; max-width: 26ch">¿Qué es un ERP (y por qué debería importarte)?</h2>
        <p style="font-size: 16px; line-height: 1.7; color: color-mix(in srgb, var(--color-text) 80%, transparent); max-width: 68ch; margin: 0 0 40px">ERP significa <em>Enterprise Resource Planning</em> — planeación de recursos empresariales. Suena complicado, pero es mucho más simple: es el sistema que junta todo lo que hoy manejas en hojas de cálculo, WhatsApp y cuadernos — inventario, clientes, ventas, empleados — en un solo lugar, con información actualizada en tiempo real.</p>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px,100%),1fr)); gap: 28px">
          <div>
            <span style="display: block; font-family: var(--font-mono); font-size: 12.5px; letter-spacing: 0.08em; text-transform: uppercase; color: #9184d9; margin-bottom: 8px">Todo en un lugar</span>
            <p style="font-size: 15px; line-height: 1.6; color: color-mix(in srgb, var(--color-text) 72%, transparent); margin: 0">Sin saltar entre el Excel de inventario, el cuaderno de ventas y el chat de WhatsApp con tu equipo.</p>
          </div>
          <div>
            <span style="display: block; font-family: var(--font-mono); font-size: 12.5px; letter-spacing: 0.08em; text-transform: uppercase; color: #6ee7b7; margin-bottom: 8px">Decisiones con datos</span>
            <p style="font-size: 15px; line-height: 1.6; color: color-mix(in srgb, var(--color-text) 72%, transparent); margin: 0">Reportes y números reales en vez de adivinar cómo va el mes.</p>
          </div>
          <div>
            <span style="display: block; font-family: var(--font-mono); font-size: 12.5px; letter-spacing: 0.08em; text-transform: uppercase; color: #f5b971; margin-bottom: 8px">Crece contigo</span>
            <p style="font-size: 15px; line-height: 1.6; color: color-mix(in srgb, var(--color-text) 72%, transparent); margin: 0">Funciona igual de bien para un negocio pequeño que para uno con varios empleados y sucursales.</p>
          </div>
        </div>
      </div>
    </section>

    <section style="background: var(--color-bg)">
      <div data-reveal="1" class="wrap" style="padding-block: 64px">
        <span style="display: block; font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent); margin-bottom: 14px">Qué incluye</span>
        <h2 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: clamp(24px,3vw,32px); margin: 0 0 36px; max-width: 24ch">6 módulos, un solo sistema.</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px,100%),1fr)); gap: 20px">
          {modules.map((m) => (
            <div class="card hover-lift">
              <div style={`width: 44px; height: 44px; border-radius: var(--radius-md); background: color-mix(in srgb, ${m.color} 16%, transparent); display: flex; align-items: center; justify-content: center; color: ${m.color}`} set:html={m.icon} />
              <h3 class="card-title" style="margin-top: 6px">{m.title}</h3>
              <p class="card-body" style="opacity: 1; color: color-mix(in srgb, var(--color-text) 75%, transparent)">{m.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section style="background: var(--color-surface)">
      <div data-reveal="1" class="wrap" style="padding-block: 64px">
        <span style="display: block; font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent); margin-bottom: 14px">Conceptos clave</span>
        <h2 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: clamp(24px,3vw,32px); margin: 0 0 36px; max-width: 28ch">Términos que quizá ya conoces, explicados sin rollo.</h2>

        <div class="stack-mobile" style="display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 40px; align-items: start">
          <div style="display: flex; flex-direction: column; gap: 36px">
            <div>
              <h3 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: 19px; margin: 0 0 8px">¿Qué es el control de inventario?</h3>
              <p style="font-size: 15.5px; line-height: 1.65; color: color-mix(in srgb, var(--color-text) 75%, transparent); margin: 0">Es saber, en todo momento, cuánto tienes de cada producto y qué se movió — sin contar a mano ni adivinar. En este ERP se hace con un <em>Kardex</em>: cada entrada y salida de almacén queda registrada con motivo, responsable y fecha.</p>
            </div>
            <div>
              <h3 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: 19px; margin: 0 0 8px">¿Qué es un POS (punto de venta)?</h3>
              <p style="font-size: 15.5px; line-height: 1.65; color: color-mix(in srgb, var(--color-text) 75%, transparent); margin: 0">Es donde registras cada venta al momento en que ocurre: qué se vendió, a quién y cómo se pagó. En este ERP esa función la cumple el módulo de <strong>Ventas</strong> — cada pedido queda con su estado (pagado, pendiente, cancelado) y se refleja al instante en el panel.</p>
            </div>
          </div>

          <div style="position: relative; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-lg); border: 1px solid var(--color-divider)">
            <div style="background: #1c1e29; padding: 10px 14px; display: flex; align-items: center; gap: 7px">
              <span style="width: 9px; height: 9px; border-radius: 50%; background: #4a4d5c"></span>
              <span style="width: 9px; height: 9px; border-radius: 50%; background: #4a4d5c"></span>
              <span style="width: 9px; height: 9px; border-radius: 50%; background: #4a4d5c"></span>
              <span style="margin-left: 8px; font-family: var(--font-mono); font-size: 10.5px; color: color-mix(in srgb, #e9e9ed 45%, transparent)">Inventarios · Kardex</span>
            </div>
            <img src="/images/demo-erp-inventarios.png" alt="Módulo de inventarios (Kardex) del ERP demo" style="display: block; width: 100%; height: auto" />
          </div>
        </div>
      </div>
    </section>

    <section style="background: var(--color-bg)">
      <div data-reveal="1" class="wrap" style="padding-block: 64px">
        <span style="display: block; font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent); margin-bottom: 14px">Para quién es</span>
        <h2 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: clamp(24px,3vw,32px); margin: 0 0 36px; max-width: 28ch">Sirve para negocios chicos y para negocios con equipo.</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px,100%),1fr)); gap: 24px">
          {businessSize.map((b) => (
            <div class="card" style={`border-left: 3px solid ${b.color}`}>
              <h3 class="card-title">{b.title}</h3>
              <ul style="margin: 4px 0 0; padding-left: 20px; display: flex; flex-direction: column; gap: 8px">
                {b.items.map((item) => (
                  <li style="font-size: 15px; line-height: 1.55; color: color-mix(in srgb, var(--color-text) 78%, transparent)">{item}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section style="background: var(--color-surface)">
      <div data-reveal="1" class="wrap" style="padding-block: 56px">
        <span style="display: block; font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent); margin-bottom: 14px">Construido para escalar</span>
        <h2 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: clamp(22px,2.8vw,28px); margin: 0 0 20px; max-width: 30ch">No es una maqueta — es la misma arquitectura que uso para sistemas en producción.</h2>
        <p style="font-size: 15.5px; line-height: 1.65; color: color-mix(in srgb, var(--color-text) 78%, transparent); max-width: 62ch; margin: 0 0 28px">Esta demo corre sobre la misma base con la que construyo sistemas reales: backend en C#, base de datos SQL Server e infraestructura en la nube — pensada para responder rápido y estar disponible cuando tu negocio la necesita.</p>
        <div style="display: flex; flex-wrap: wrap; gap: 8px">
          {['Blazor WebAssembly', 'C#', 'SQL Server', 'Azure'].map((t) => (
            <span class="tag tag-neutral" style="font-family: var(--font-mono)">{t}</span>
          ))}
        </div>
      </div>
    </section>

    <section style="background: linear-gradient(180deg, var(--color-surface), var(--color-section-glow) 240%)">
      <div data-reveal="1" class="wrap" style="padding-block: 56px 88px; display: flex; flex-direction: column; gap: 16px">
        <h2 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: clamp(22px,2.6vw,28px); margin: 0; max-width: 26ch">¿Y si tu negocio ya operara así?</h2>
        <p style="font-size: 16px; color: color-mix(in srgb, var(--color-text) 72%, transparent); margin: 0; max-width: 48ch">Pruébalo tú mismo, y si te late, hablamos de cómo se vería hecho a la medida de tu negocio.</p>
        <div style="display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px">
          <a href={DEMO_ERP_URL} target="_blank" rel="noopener" class="btn btn-solid-accent">Probar la demo en vivo →</a>
          <a href="https://wa.me/528117788448" target="_blank" rel="noopener" class="btn btn-primary">Escribir por WhatsApp</a>
        </div>
      </div>
    </section>

  </main>
</Layout>

<style>
  .btn-solid-accent {
    background: var(--color-accent);
    color: var(--color-bg);
    border-color: var(--color-accent);
  }
  .btn-solid-accent:hover {
    background: var(--color-accent-400);
    border-color: var(--color-accent-400);
  }
  .btn-solid-accent:active {
    background: var(--color-accent-600);
    border-color: var(--color-accent-600);
  }
</style>
