---
import Layout from '../layouts/Layout.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import { WHATSAPP_URL, WHATSAPP_DISPLAY, CONTACT_EMAIL } from '../data/nav';

const faqs = [
  { q: '¿Trabajas con empresas fuera de mi país?', a: 'Sí, trabajo de forma remota con clientes en distintas ubicaciones; toda la comunicación y seguimiento se hace en línea.' },
  { q: '¿Cuánto tiempo toma desarrollar un sistema?', a: 'Depende del alcance. Un módulo acotado puede tomar unas semanas; una plataforma completa con varios roles y flujos toma más tiempo. Lo defino junto contigo después del diagnóstico inicial.' },
  { q: '¿Qué pasa si necesito cambios después de la entrega?', a: 'Ofrezco soporte posterior a la entrega y puedo tomar nuevas fases de desarrollo cuando el negocio lo necesite.' },
  { q: '¿Trabajas solo con Blazor o también otras tecnologías?', a: 'Blazor WebAssembly, C# y SQL Server son mi stack principal, y también desarrollo apps móviles (Android/iOS) e implementaciones en la nube con Azure cuando el proyecto lo requiere.' },
  { q: '¿Puedo ver el sistema mientras se construye?', a: 'Sí. Trabajo en iteraciones revisables, así que puedes ver avances reales del sistema durante el desarrollo, no solo al final.' },
];
---
<Layout title="Contacto — ZA Desarrollo Software">
  <main>
    <section style="background: var(--color-bg)">
     <div class="wrap" style="padding-block: 36px 40px">
      <span style="display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.04em; color: color-mix(in srgb, var(--color-text) 75%, transparent); background: color-mix(in srgb, var(--color-surface) 55%, transparent); backdrop-filter: blur(10px); border: 1px solid color-mix(in srgb, var(--color-text) 10%, transparent); padding: 6px 12px; border-radius: 999px; margin-bottom: 24px">
        <span style="width: 6px; height: 6px; border-radius: 50%; background: var(--color-accent); flex: none"></span>
        Disponibilidad: nuevos proyectos 2026
      </span>
      <h1 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: clamp(28px,4.4vw,44px); margin: 0; max-width: 18ch">Hablemos de tu próximo proyecto.</h1>
      <p style="font-size: 16px; line-height: 1.7; color: color-mix(in srgb, var(--color-text) 78%, transparent); max-width: 54ch; margin: 20px 0 0">Diseño y construyo sistemas de software para empresas que necesitan fiabilidad estructural, no una plantilla genérica. Cuento con portafolio de evidencias y referencias de otros sistemas que he desarrollado.</p>
     </div>
    </section>

    <section style="background: var(--color-surface)">
     <div class="stack-mobile wrap" style="padding-block: 40px 96px; display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1.1fr); gap: 40px; align-items: start">
      <div style="display: flex; flex-direction: column; gap: 14px">
        <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="card contact-card" style="flex-direction: row; align-items: center; gap: 16px; text-decoration: none; color: inherit; transition: box-shadow .25s ease; background: var(--color-bg)">
          <div style="width: 44px; height: 44px; flex: none; border-radius: var(--radius-sm); background: color-mix(in srgb, var(--color-accent) 14%, transparent); display: flex; align-items: center; justify-content: center; color: var(--color-accent)">
            <WhatsAppIcon size={22} />
          </div>
          <div style="flex: 1; min-width: 0">
            <h2 class="card-kicker" style="margin-bottom: 4px">WhatsApp directo</h2>
            <p style="font-size: 15.5px; font-weight: 500; margin: 0">{WHATSAPP_DISPLAY}</p>
          </div>
          <span style="color: var(--color-accent)">→</span>
        </a>
        <a href={`mailto:${CONTACT_EMAIL}`} class="card contact-card" style="flex-direction: row; align-items: center; gap: 16px; text-decoration: none; color: inherit; transition: box-shadow .25s ease; background: var(--color-bg)">
          <div style="width: 44px; height: 44px; flex: none; border-radius: var(--radius-sm); background: color-mix(in srgb, var(--color-accent) 14%, transparent); display: flex; align-items: center; justify-content: center; color: var(--color-accent)">
            <svg width="22" height="22" viewBox="0 0 256 256" fill="currentColor"><path d="M224,48H32a8,8,0,0,0-8,8V192a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V56A8,8,0,0,0,224,48Zm-96,85.15L52.57,64H203.43ZM98.71,128,40,181.81V74.19Zm11.84,10.85,12.63,11.51a8,8,0,0,0,10.64,0l12.63-11.51L207.43,192H48.57ZM157.29,128,216,74.18V181.82Z"></path></svg>
          </div>
          <div style="flex: 1; min-width: 0">
            <h2 class="card-kicker" style="margin-bottom: 4px">Correo</h2>
            <p style="font-size: 15.5px; font-weight: 500; margin: 0; overflow-wrap: anywhere">{CONTACT_EMAIL}</p>
          </div>
          <span style="color: var(--color-accent)">→</span>
        </a>
        <p style="font-size: 12.5px; color: color-mix(in srgb, var(--color-text) 50%, transparent); margin: 4px 4px 0; font-family: var(--font-mono)">Ing. Jassiel Zamarrón</p>
        <div style="position: relative; width: 100%; aspect-ratio: 16/10; border-radius: var(--radius-lg); overflow: hidden; margin-top: 8px">
          <img src="/images/desk-setup.jpg" alt="Espacio de trabajo de Ing. Jassiel Zamarrón" class="img-cover" />
          <span style="position: absolute; top: 14px; left: 14px; pointer-events: none; font-family: var(--font-mono); font-size: 10.5px; color: var(--color-text); background: color-mix(in srgb, var(--color-bg) 55%, transparent); backdrop-filter: blur(10px); padding: 5px 10px; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent)">Donde construyo tu sistema</span>
        </div>
      </div>

      <div class="card" style="padding: 32px; background: var(--color-bg)">
        <h2 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: 20px; margin: 0 0 24px">Consulta de proyecto</h2>
        <form id="contact-form" style="display: flex; flex-direction: column; gap: 18px">
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(160px,100%),1fr)); gap: 16px">
            <div class="field">
              <label for="name">Nombre</label>
              <input id="name" name="name" class="input" type="text" required placeholder="Tu nombre" />
            </div>
            <div class="field">
              <label for="company">Empresa</label>
              <input id="company" name="company" class="input" type="text" placeholder="Opcional" />
            </div>
          </div>
          <div class="field">
            <label for="email">Correo</label>
            <input id="email" name="email" class="input" type="email" required placeholder="correo@empresa.com" />
          </div>
          <div class="field">
            <label for="message">Descripción del proyecto</label>
            <textarea id="message" name="message" class="input" required placeholder="Qué proceso o problema necesitas resolver…" rows="4"></textarea>
          </div>
          <button type="submit" class="btn btn-primary" style="align-self: flex-start">Enviar propuesta →</button>
          <p id="contact-sent" hidden style="font-family: var(--font-mono); font-size: 12.5px; color: color-mix(in srgb, var(--color-text) 60%, transparent); margin: 0">&gt; Se abrió tu cliente de correo con la propuesta. Si no ocurre, escribe directamente a {CONTACT_EMAIL}.</p>
        </form>
      </div>
     </div>
    </section>

    <section style="background: var(--color-section)">
     <div data-reveal="1" class="wrap" style="padding-block: 56px 96px">
      <h2 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: clamp(20px,2.4vw,24px); margin: 0 0 24px">Preguntas frecuentes</h2>
      <div style="display: flex; flex-direction: column">
        {faqs.map((faq, i) => (
          <div class="faq-item" style="border-top: 1px solid var(--color-divider)">
            <button type="button" class="faq-toggle" data-faq={i} style="width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 0; background: transparent; border: none; text-align: left; cursor: pointer; color: var(--color-text)">
              <span style="font-family: var(--font-heading); font-weight: 500; font-size: 17px">{faq.q}</span>
              <span class="faq-sign" style="font-family: var(--font-mono); font-size: 18px; color: var(--color-accent); flex: none">+</span>
            </button>
            <p class="faq-answer" hidden style="font-size: 15.5px; line-height: 1.65; color: color-mix(in srgb, var(--color-text) 72%, transparent); margin: 0 0 20px; max-width: 58ch">{faq.a}</p>
          </div>
        ))}
      </div>
     </div>
    </section>
  </main>
</Layout>

<style>
  .contact-card:hover {
    box-shadow: 0 0 0 1px var(--color-accent);
  }
</style>

<script define:vars={{ CONTACT_EMAIL }}>
  const form = document.getElementById('contact-form');
  const sentMsg = document.getElementById('contact-sent');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const name = data.get('name') || '';
    const company = data.get('company') || '';
    const email = data.get('email') || '';
    const message = data.get('message') || '';

    const subject = encodeURIComponent(`Consulta de proyecto — ${name || 'Nuevo contacto'}`);
    const body = encodeURIComponent(
      `Nombre: ${name}\nEmpresa: ${company || '—'}\nCorreo: ${email}\n\n${message}`
    );
    window.location.href = `mailto:${CONTACT_EMAIL}?subject=${subject}&body=${body}`;
    if (sentMsg) sentMsg.hidden = false;
  });

  const faqItems = document.querySelectorAll('.faq-item');
  faqItems.forEach((item) => {
    const toggle = item.querySelector('.faq-toggle');
    const answer = item.querySelector('.faq-answer');
    const sign = item.querySelector('.faq-sign');
    toggle?.addEventListener('click', () => {
      const isOpen = !answer.hidden;
      faqItems.forEach((other) => {
        if (other !== item) {
          other.querySelector('.faq-answer').hidden = true;
          other.querySelector('.faq-sign').textContent = '+';
        }
      });
      answer.hidden = isOpen;
      sign.textContent = isOpen ? '+' : '−';
    });
  });
</script>
