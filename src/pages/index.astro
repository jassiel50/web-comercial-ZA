---
import Layout from '../layouts/Layout.astro';

const stack = ['Blazor WebAssembly', 'C#', '.NET', 'SQL Server', 'Radzen'];

const heroStats = [
  { label: 'Disponibilidad', value: '99.99%', color: '#6ee7b7' },
  { label: 'Tiempo de respuesta', value: '< 50ms', color: '#6ee7b7' },
  { label: 'Implementación', value: 'Sin pausas', color: '#9184d9' },
  { label: 'Acceso', value: 'Multiplataforma', color: '#9184d9' },
];

const statTiles = [
  { value: '128', label: 'Movimientos hoy', color: '#9184d9' },
  { value: '3,240', label: 'Stock total', color: '#6ee7b7' },
  { value: '12/12', label: 'Ubicaciones activas', color: '#6ee7b7' },
  { value: '2', label: 'Alertas', color: '#f5b971' },
];

const activity = [
  { action: 'Ingreso — Almacén A', time: 'hace 2 min' },
  { action: 'Ajuste — Almacén B', time: 'hace 15 min' },
  { action: 'Salida — Almacén A', time: 'hace 38 min' },
];

const comparison = [
  { label: 'Datos centralizados', sheets: '✗', generic: '△' },
  { label: 'Acceso por roles', sheets: '✗', generic: '△' },
  { label: 'Reportes en tiempo real', sheets: '✗', generic: '△' },
  { label: 'Se adapta a tu proceso', sheets: '△', generic: '✗' },
  { label: 'Soporte directo y continuo', sheets: '✗', generic: '△' },
];

const principles = [
  {
    n: '01',
    title: 'Menos errores, más control',
    body: 'Tu negocio opera día a día sin interrupciones ni datos inconsistentes entre tu equipo.',
    color: '#9184d9',
    icon: '<svg width="22" height="22" viewBox="0 0 256 256" fill="currentColor"><path d="M208,40H48A16,16,0,0,0,32,56v58.78c0,80.36,75.8,113.28,91.36,119.4a15.94,15.94,0,0,0,9.28,0C148.2,228.06,224,195.14,224,114.78V56A16,16,0,0,0,208,40Zm-33.66,74.34-56,56a8,8,0,0,1-11.31,0l-24-24a8,8,0,1,1,11.31-11.31L112,152.69l50.34-50.35a8,8,0,1,1,11.32,11.32Z"/></svg>',
  },
  {
    n: '02',
    title: 'Tu información, protegida',
    body: 'Cada persona de tu equipo ve solo lo que le corresponde, con accesos y permisos claros desde el primer día.',
    color: '#6ee7b7',
    icon: '<svg width="22" height="22" viewBox="0 0 256 256" fill="currentColor"><path d="M208,80H72V56a56,56,0,0,1,112,0,8,8,0,0,0,16,0,72,72,0,0,0-144,0V80H48A16,16,0,0,0,32,96V208a16,16,0,0,0,16,16H208a16,16,0,0,0,16-16V96A16,16,0,0,0,208,80Zm0,128H48V96H208V208Z"/></svg>',
  },
  {
    n: '03',
    title: 'Un sistema que crece contigo',
    body: 'Pensado para escalar cuando tu negocio lo necesite, sin tener que empezar de cero.',
    color: '#f5b971',
    icon: '<svg width="22" height="22" viewBox="0 0 256 256" fill="currentColor"><path d="M235.5,113.6l-104-56a8,8,0,0,0-7.6,0l-104,56a8,8,0,0,0,0,14.1L44.6,138,20.4,151.6a8,8,0,0,0,0,14.1l104,56.1a8,8,0,0,0,7.6,0l104-56.1a8,8,0,0,0,0-14.1L211.4,138l24.1-10.6a8,8,0,0,0,0-13.8ZM128,73.7,211.9,120,128,166.3,44.1,120ZM128,204.3,37,153.8l18.9-10.4L124,177.9a8,8,0,0,0,7.6,0l68.1-34.5L218.6,153.8Z"/></svg>',
  },
];

const projects = [
  {
    code: 'INV_SYS // 01',
    title: 'Sistema de control de inventario y almacén',
    summary: 'Reemplazo de hojas de cálculo y procesos manuales por un panel centralizado con trazabilidad de stock.',
    tags: ['Blazor WebAssembly', 'SQL Server', 'Radzen'],
    href: '/caso-inventario',
    imgSrc: '/images/erp-dashboard.jpg',
  },
  {
    code: 'PORTAL_MGT // 02',
    title: 'Portal de gestión para clientes y proveedores',
    summary: 'Un portal con roles y permisos donde cada cliente ve solo su información, sin depender de correos sueltos.',
    tags: ['Blazor WebAssembly', 'C#', 'SQL Server'],
    href: '/caso-portal',
    imgSrc: '/images/server-room.jpg',
  },
  {
    code: 'PLAT_RBAC // 03',
    title: 'Plataforma administrativa con acceso seguro por roles',
    summary: 'Autenticación robusta y control granular de permisos para equipos internos de distintas áreas.',
    tags: ['C#', '.NET', 'Radzen', 'SQL Server'],
    href: '/caso-plataforma',
    imgSrc: '/images/network-security.jpg',
  },
];
---
<Layout title="ZA Desarrollo Software — Sistemas a medida para tu negocio" footerVariant="full">
  <main>

    <section class="wrap" style="padding-block: 20px 28px">
      <div class="hero-panel stack-mobile" style="display: grid; grid-template-columns: minmax(0,1.15fr) minmax(0,1fr); gap: 40px; align-items: center; background: var(--color-surface); border: 1px solid var(--color-divider); border-left: 3px solid var(--color-accent); border-radius: var(--radius-lg); padding: clamp(20px,3.2vw,36px); box-shadow: var(--shadow-md)">
        <div>
          <span style="display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.06em; text-transform: uppercase; color: color-mix(in srgb, var(--color-text) 75%, transparent); background: color-mix(in srgb, var(--color-bg) 55%, transparent); backdrop-filter: blur(10px); border: 1px solid color-mix(in srgb, var(--color-text) 10%, transparent); padding: 6px 12px; border-radius: 999px; margin-bottom: 14px">
            <span style="width: 6px; height: 6px; border-radius: 50%; background: #6ee7b7; flex: none; animation: waPulse 2s ease-in-out infinite"></span>
            Disponible para nuevos proyectos
          </span>
          <h1 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: clamp(28px,4vw,42px); line-height: 1.14; letter-spacing: -0.015em; margin: 0; max-width: 26ch">Digitaliza tu negocio y optimiza cada proceso, sin complicaciones.</h1>
          <p style="font-size: 15.5px; line-height: 1.55; color: color-mix(in srgb, var(--color-text) 78%, transparent); max-width: 52ch; margin: 14px 0 0; border-left: 2px solid var(--color-accent); padding-left: 16px">Diseño y construyo sistemas a la medida que resuelven los problemas reales de tu negocio: inventario, clientes, accesos y reportes — centralizados y disponibles desde tu computadora o tu celular, sin depender de hojas de cálculo ni procesos manuales.</p>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(120px,45%),1fr)); gap: 14px; margin-top: 16px">
            {heroStats.map((s) => (
              <div style="padding-left: 16px; border-left: 1px solid var(--color-divider)">
                <span style="display: block; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: color-mix(in srgb, var(--color-text) 55%, transparent); margin-bottom: 4px">{s.label}</span>
                <span style={`font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: 18px; color: ${s.color}`}>{s.value}</span>
              </div>
            ))}
          </div>
          <p style="font-size: 11px; font-family: var(--font-mono); color: color-mix(in srgb, var(--color-text) 40%, transparent); margin: 6px 0 0">Cifras objetivo de referencia para el tipo de sistemas que construyo, no mediciones de un cliente en particular.</p>
          <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-top: 14px">
            <a href="https://wa.me/528117788448" target="_blank" rel="noopener" class="btn btn-solid-accent">Hablemos de tu proyecto</a>
            <a href="#arquitectura" class="btn btn-secondary">Ver cómo funciona</a>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px">
            {stack.map((s) => (
              <span class="tag tag-outline" style="font-family: var(--font-mono)">{s}</span>
            ))}
          </div>
        </div>
        <div style="position: relative; width: 100%; aspect-ratio: 16/11; border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-lg)">
          <img src="/images/hero-main.jpg" alt="Data center con arquitectura de software — ZA Desarrollo Software" class="img-cover" />
          <div style="position: absolute; bottom: 14px; right: 14px; margin-left: auto; width: min(250px, 68%); pointer-events: none; font-family: var(--font-mono); font-size: 10px; line-height: 1.6; color: color-mix(in srgb, var(--color-text) 88%, transparent); background: color-mix(in srgb, var(--color-bg) 68%, transparent); backdrop-filter: blur(10px); border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent); border-radius: var(--radius-sm); padding: 9px 11px; overflow: hidden">
            <p style="margin: 0; color: color-mix(in srgb, var(--color-text) 50%, transparent)">~ $ tail -f /var/log/sys.log</p>
            <p style="margin: 3px 0 0"><span style="color: #6ee7b7">[OK]</span> Core modules initialized.</p>
            <p style="margin: 3px 0 0"><span style="color: #6ee7b7">[OK]</span> Secure connection established.</p>
            <p style="margin: 3px 0 0"><span style="color: #6ee7b7">[OK]</span> Microservices scaling up...</p>
          </div>
        </div>
      </div>
    </section>

    <section id="arquitectura" style="background: var(--color-surface); scroll-margin-top: 96px">
      <div data-reveal="1" class="wrap" style="padding-block: 64px">
        <span style="display: block; font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent); margin-bottom: 14px">Así se ve por dentro</span>
        <h2 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: clamp(24px,3vw,32px); margin: 0 0 36px; max-width: 34ch">Así se ve tener el control total de tu negocio.</h2>
        <div class="panel-grid" style="display: grid; grid-template-columns: 1fr; gap: 20px">
          <div class="card elev-sm panel-span" style="min-width: 0; background: var(--color-bg)">
            <div style="display: flex; align-items: center; justify-content: space-between">
              <span class="card-title" style="font-size: 18px">Panel de inventario</span>
              <span style="display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.06em; color: color-mix(in srgb, var(--color-text) 60%, transparent)">
                <span style="width: 6px; height: 6px; border-radius: 50%; background: #6ee7b7; animation: waPulse 2s ease-in-out infinite"></span>
                EN VIVO
              </span>
            </div>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(110px,100%),1fr)); gap: 12px; margin-top: 8px">
              {statTiles.map((t) => (
                <div style="padding: 12px; background: var(--color-surface); border-radius: var(--radius-sm)">
                  <p style={`font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: 21px; margin: 0; color: ${t.color}`}>{t.value}</p>
                  <p style="font-size: 11.5px; color: color-mix(in srgb, var(--color-text) 55%, transparent); margin: 4px 0 0">{t.label}</p>
                </div>
              ))}
            </div>
            <div style="margin-top: 16px">
              <p style="font-size: 11px; color: color-mix(in srgb, var(--color-text) 55%, transparent); margin: 0 0 8px">Movimientos · últimos 7 días</p>
              <svg width="100%" height="48" viewBox="0 0 280 48" preserveAspectRatio="none"><polyline points="0,36 40,30 80,34 120,18 160,24 200,10 240,16 280,6" fill="none" stroke="var(--color-accent)" stroke-width="2"></polyline></svg>
            </div>
            <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 16px; border-top: 1px solid var(--color-divider); padding-top: 14px">
              {activity.map((a) => (
                <div style="display: flex; justify-content: space-between; font-size: 12.5px">
                  <span style="color: color-mix(in srgb, var(--color-text) 80%, transparent)">{a.action}</span>
                  <span style="font-family: var(--font-mono); color: color-mix(in srgb, var(--color-text) 45%, transparent)">{a.time}</span>
                </div>
              ))}
            </div>
          </div>
          <div class="card elev-sm" style="background: var(--color-bg)">
            <span class="card-title" style="font-size: 18px">Acceso por roles</span>
            <p class="card-body" style="opacity: 1; color: color-mix(in srgb, var(--color-text) 70%, transparent); margin-top: 4px">Cada usuario ve solo lo que corresponde a su función.</p>
            <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px">
              <span class="tag tag-accent" style="font-family: var(--font-mono)">Admin</span>
              <span class="tag tag-outline" style="font-family: var(--font-mono)">Ventas</span>
              <span class="tag tag-outline" style="font-family: var(--font-mono)">Bodega</span>
            </div>
          </div>
          <div class="card elev-sm" style="background: var(--color-bg)">
            <span class="card-title" style="font-size: 18px">Conectado con tus otras herramientas</span>
            <p class="card-body" style="opacity: 1; color: color-mix(in srgb, var(--color-text) 70%, transparent); margin-top: 4px">Tu sistema se conecta con otras plataformas que ya usa tu negocio, sin trabajo manual de por medio.</p>
            <div style="margin-top: 12px; background: var(--color-surface); border-radius: var(--radius-sm); padding: 10px 12px; font-family: var(--font-mono); font-size: 11px; color: color-mix(in srgb, var(--color-text) 70%, transparent)">
              <div>GET /api/inventario/stock</div>
              <div style="color: var(--color-accent); margin-top: 4px">→ 200 {'{ data: [...] }'}</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section style="background: var(--color-bg)">
      <div data-reveal="1" class="wrap" style="padding-block: 64px">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 14px">
          <svg width="14" height="14" viewBox="0 0 256 256" fill="currentColor" style="color: var(--color-accent); flex: none"><path d="M216,48H136V40a16,16,0,0,0-16-16H40A16,16,0,0,0,24,40V200a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V64A16,16,0,0,0,216,48ZM40,40h80V48H40Zm176,160H40V64H216Z"/></svg>
          <span style="font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent)">Casos de éxito // Proyectos</span>
        </div>
        <h2 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: clamp(24px,3vw,32px); margin: 0 0 36px; max-width: 30ch">Soluciones que resuelven problemas reales de negocio.</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px,100%),1fr)); gap: 20px">
          {projects.map((p) => (
            <a href={p.href} class="card elev-sm project-card" style="text-decoration: none; color: inherit; transition: transform .25s ease, box-shadow .25s ease; background: var(--color-surface)">
              <div style="position: relative; width: 100%; aspect-ratio: 16/10; border-radius: var(--radius-sm); overflow: hidden">
                <img src={p.imgSrc} alt={p.title} class="img-cover" />
                <span style="position: absolute; top: 10px; left: 10px; font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.06em; color: var(--color-accent); background: color-mix(in srgb, var(--color-bg) 65%, transparent); backdrop-filter: blur(10px); padding: 4px 9px; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent)">{p.code}</span>
              </div>
              <h3 class="card-title" style="margin-top: 10px">{p.title}</h3>
              <p class="card-body">{p.summary}</p>
              <div style="display: flex; flex-wrap: wrap; gap: 6px; padding-top: 12px; margin-top: auto; border-top: 1px solid var(--color-divider)">
                {p.tags.map((t) => (
                  <span style="font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.02em; padding: 3px 10px; border-radius: calc(var(--radius-md) * 0.75); border: 1px solid var(--color-divider); color: color-mix(in srgb, var(--color-text) 78%, transparent)">{t}</span>
                ))}
              </div>
              <span style="font-size: 13px; font-weight: 500; color: var(--color-accent); margin-top: 4px">Ver caso de estudio →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section style="background: var(--color-section)">
      <div data-reveal="1" class="wrap" style="padding-block: 64px">
        <span style="display: block; font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent); margin-bottom: 14px">Por qué digitalizar tu negocio</span>
        <h2 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: clamp(22px,2.8vw,30px); margin: 0 0 36px; max-width: 30ch">Beneficios que se notan desde el primer día.</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px,100%),1fr)); gap: 28px">
          {principles.map((pr) => (
            <div>
              <div style={`width: 42px; height: 42px; border-radius: var(--radius-md); background: color-mix(in srgb, ${pr.color} 18%, transparent); display: flex; align-items: center; justify-content: center; color: ${pr.color}; margin-bottom: 16px`} set:html={pr.icon} />
              <span style={`display: block; font-family: var(--font-mono); font-size: 12.5px; letter-spacing: 0.08em; text-transform: uppercase; color: ${pr.color}; margin-bottom: 10px`}>{pr.n} · {pr.title}</span>
              <p style="font-size: 15.5px; line-height: 1.6; color: color-mix(in srgb, var(--color-text) 75%, transparent); margin: 0; max-width: 34ch">{pr.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section style="background: var(--color-bg)">
      <div data-reveal="1" class="wrap" style="padding-block: 64px">
        <span style="display: block; font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent); margin-bottom: 14px">Comparativa</span>
        <h2 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: clamp(22px,2.8vw,30px); margin: 0 0 32px; max-width: 30ch">¿Por qué un sistema a la medida?</h2>
        <div style="overflow-x: auto">
          <table class="table" style="min-width: 480px">
            <thead>
              <tr>
                <th></th>
                <th style="color: var(--color-accent)">Sistema a la medida</th>
                <th>Hojas de cálculo</th>
                <th>Software genérico</th>
              </tr>
            </thead>
            <tbody>
              {comparison.map((row) => (
                <tr>
                  <td style="color: color-mix(in srgb, var(--color-text) 80%, transparent)">{row.label}</td>
                  <td style="color: var(--color-accent)">✓</td>
                  <td style="color: color-mix(in srgb, var(--color-text) 40%, transparent)">{row.sheets}</td>
                  <td style="color: color-mix(in srgb, var(--color-text) 40%, transparent)">{row.generic}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section style="background: linear-gradient(180deg, var(--color-surface), var(--color-section-glow) 240%)">
      <div data-reveal="1" class="wrap" style="padding-block: 56px 88px; display: flex; flex-direction: column; gap: 16px">
        <h2 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: clamp(22px,2.6vw,28px); margin: 0; max-width: 26ch">¿Tienes un proceso manual que le está costando tiempo a tu equipo?</h2>
        <p style="font-size: 16px; color: color-mix(in srgb, var(--color-text) 72%, transparent); margin: 0; max-width: 48ch">Cuéntame qué necesitas resolver y evaluamos juntos si puedo ayudarte a construirlo.</p>
        <div>
          <a href="https://wa.me/528117788448" target="_blank" rel="noopener" class="btn btn-primary" style="margin-top: 8px">Escribir por WhatsApp</a>
        </div>
      </div>
    </section>

  </main>
</Layout>

<style>
  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }
  /* The panel card shares its row with two 1-column cards on wide layouts;
     spanning 2 grid tracks would force a second 300px track even when the
     viewport can't fit it, so the span only applies once two tracks exist. */
  .panel-span {
    grid-column: span 1;
  }
  @media (min-width: 641px) {
    .panel-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .panel-span {
      grid-column: span 2;
    }
  }
  .btn-solid-accent {
    background: var(--color-accent);
    color: var(--color-bg);
    border-color: var(--color-accent);
  }
  .btn-solid-accent:hover {
    background: var(--color-accent-400);
    border-color: var(--color-accent-400);
  }
  .btn-solid-accent:active {
    background: var(--color-accent-600);
    border-color: var(--color-accent-600);
  }
</style>
