---
import Layout from '../layouts/Layout.astro';

const stack = ['Blazor WebAssembly', 'C#', '.NET', 'SQL Server', 'Radzen'];

const statTiles = [
  { value: '128', label: 'Movimientos hoy' },
  { value: '3,240', label: 'Stock total' },
  { value: '12/12', label: 'Ubicaciones activas' },
  { value: '2', label: 'Alertas' },
];

const activity = [
  { action: 'Ingreso — Almacén A', time: 'hace 2 min' },
  { action: 'Ajuste — Almacén B', time: 'hace 15 min' },
  { action: 'Salida — Almacén A', time: 'hace 38 min' },
];

const comparison = [
  { label: 'Datos centralizados', sheets: '✗', generic: '△' },
  { label: 'Acceso por roles', sheets: '✗', generic: '△' },
  { label: 'Reportes en tiempo real', sheets: '✗', generic: '△' },
  { label: 'Se adapta a tu proceso', sheets: '△', generic: '✗' },
  { label: 'Soporte directo y continuo', sheets: '✗', generic: '△' },
];

const principles = [
  {
    n: '01',
    title: 'Confiabilidad absoluta',
    body: 'Sistemas diseñados para operar día a día sin degradación, con datos consistentes entre todos los usuarios.',
    icon: '<svg width="18" height="18" viewBox="0 0 256 256" fill="currentColor"><path d="M208,40H48A16,16,0,0,0,32,56v58.78c0,80.36,75.8,113.28,91.36,119.4a15.94,15.94,0,0,0,9.28,0C148.2,228.06,224,195.14,224,114.78V56A16,16,0,0,0,208,40Zm-33.66,74.34-56,56a8,8,0,0,1-11.31,0l-24-24a8,8,0,1,1,11.31-11.31L112,152.69l50.34-50.35a8,8,0,1,1,11.32,11.32Z"/></svg>',
  },
  {
    n: '02',
    title: 'Seguridad por diseño',
    body: 'Autenticación, roles y permisos pensados desde el inicio de la arquitectura, no agregados después.',
    icon: '<svg width="18" height="18" viewBox="0 0 256 256" fill="currentColor"><path d="M208,80H72V56a56,56,0,0,1,112,0,8,8,0,0,0,16,0,72,72,0,0,0-144,0V80H48A16,16,0,0,0,32,96V208a16,16,0,0,0,16,16H208a16,16,0,0,0,16-16V96A16,16,0,0,0,208,80Zm0,128H48V96H208V208Z"/></svg>',
  },
  {
    n: '03',
    title: 'Estándares corporativos',
    body: 'Código documentado y mantenible, pensado para que el sistema pueda crecer con el negocio.',
    icon: '<svg width="18" height="18" viewBox="0 0 256 256" fill="currentColor"><path d="M235.5,113.6l-104-56a8,8,0,0,0-7.6,0l-104,56a8,8,0,0,0,0,14.1L44.6,138,20.4,151.6a8,8,0,0,0,0,14.1l104,56.1a8,8,0,0,0,7.6,0l104-56.1a8,8,0,0,0,0-14.1L211.4,138l24.1-10.6a8,8,0,0,0,0-13.8ZM128,73.7,211.9,120,128,166.3,44.1,120ZM128,204.3,37,153.8l18.9-10.4L124,177.9a8,8,0,0,0,7.6,0l68.1-34.5L218.6,153.8Z"/></svg>',
  },
];

const projects = [
  {
    title: 'Sistema de control de inventario y almacén',
    summary: 'Reemplazo de hojas de cálculo y procesos manuales por un panel centralizado con trazabilidad de stock.',
    tags: ['Blazor WebAssembly', 'SQL Server', 'Radzen'],
    href: '/caso-inventario',
    imgSrc: '/images/erp-dashboard.jpg',
  },
  {
    title: 'Portal de gestión para clientes y proveedores',
    summary: 'Un portal con roles y permisos donde cada cliente ve solo su información, sin depender de correos sueltos.',
    tags: ['Blazor WebAssembly', 'C#', 'SQL Server'],
    href: '/caso-portal',
    imgSrc: '/images/server-room.jpg',
  },
  {
    title: 'Plataforma administrativa con acceso seguro por roles',
    summary: 'Autenticación robusta y control granular de permisos para equipos internos de distintas áreas.',
    tags: ['C#', '.NET', 'Radzen', 'SQL Server'],
    href: '/caso-plataforma',
    imgSrc: '/images/network-security.jpg',
  },
];
---
<Layout title="ZA Desarrollo Software — Sistemas a medida para tu negocio" footerVariant="full">
  <main style="max-width: 1120px; margin: 0 auto; padding: 0 clamp(20px,5vw,64px)">

    <section style="padding: 72px 0 56px; display: grid; grid-template-columns: minmax(0,1.15fr) minmax(0,1fr); gap: 48px; align-items: center; background: radial-gradient(1100px 600px at 88% -10%, color-mix(in srgb, var(--color-accent-900) 60%, transparent), transparent 60%)">
      <div>
        <span style="display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.04em; color: color-mix(in srgb, var(--color-text) 75%, transparent); background: color-mix(in srgb, var(--color-surface) 55%, transparent); backdrop-filter: blur(10px); border: 1px solid color-mix(in srgb, var(--color-text) 10%, transparent); padding: 6px 12px; border-radius: 999px; margin-bottom: 24px">
          <span style="width: 6px; height: 6px; border-radius: 50%; background: var(--color-accent); flex: none"></span>
          Disponible para nuevos proyectos
        </span>
        <span style="display: block; font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent); margin-bottom: 20px">Desarrollo de sistemas empresariales</span>
        <h1 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: clamp(32px,5vw,50px); line-height: 1.12; letter-spacing: -0.015em; margin: 0; max-width: 16ch">Construyo los sistemas internos que tu negocio necesita para operar sin fricción.</h1>
        <p style="font-size: 16.5px; line-height: 1.6; color: color-mix(in srgb, var(--color-text) 78%, transparent); max-width: 52ch; margin: 24px 0 0">Desarrollador full-stack especializado en Blazor WebAssembly, C# y SQL Server. Diseño y construyo portales de gestión, sistemas de inventario y plataformas con acceso seguro por roles para empresas que necesitan una herramienta a la medida, no una plantilla genérica.</p>
        <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px">
          <a href="/proyectos" class="btn btn-primary">Ver proyectos</a>
          <a href="https://wa.me/528117788448" target="_blank" rel="noopener" class="btn btn-secondary">Hablar por WhatsApp</a>
        </div>
        <div style="display: flex; flex-wrap: wrap; gap: 10px; margin-top: 40px">
          {stack.map((s) => (
            <span class="tag tag-outline" style="font-family: var(--font-mono)">{s}</span>
          ))}
        </div>
      </div>
      <div style="position: relative; width: 100%; aspect-ratio: 4/3; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-lg)">
        <img src="/images/hero-main.jpg" alt="Espacio de trabajo de ZA Desarrollo Software" class="img-cover" />
        <span style="position: absolute; bottom: 16px; left: 16px; pointer-events: none; display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 11px; color: var(--color-text); background: color-mix(in srgb, var(--color-bg) 55%, transparent); backdrop-filter: blur(10px); padding: 6px 12px; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent)">ZA Desarrollo Software</span>
      </div>
    </section>

    <section data-reveal="1" style="padding: 64px 0">
      <span style="display: block; font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent); margin-bottom: 14px">Así se ve por dentro</span>
      <h2 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: clamp(24px,3vw,32px); margin: 0 0 36px; max-width: 34ch">Un vistazo real al tipo de panel que construyo.</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px,100%),1fr)); gap: 20px; margin-bottom: 72px">
        <div class="card elev-sm panel-span" style="min-width: 0">
          <div style="display: flex; align-items: center; justify-content: space-between">
            <span class="card-title" style="font-size: 16px">Panel de inventario</span>
            <span style="display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.06em; color: color-mix(in srgb, var(--color-text) 60%, transparent)">
              <span style="width: 6px; height: 6px; border-radius: 50%; background: #6ee7b7; animation: waPulse 2s ease-in-out infinite"></span>
              EN VIVO
            </span>
          </div>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(110px,100%),1fr)); gap: 12px; margin-top: 8px">
            {statTiles.map((t) => (
              <div style="padding: 12px; background: var(--color-bg); border-radius: var(--radius-sm)">
                <p style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: 20px; margin: 0; color: var(--color-text)">{t.value}</p>
                <p style="font-size: 10.5px; color: color-mix(in srgb, var(--color-text) 55%, transparent); margin: 4px 0 0">{t.label}</p>
              </div>
            ))}
          </div>
          <div style="margin-top: 16px">
            <p style="font-size: 11px; color: color-mix(in srgb, var(--color-text) 55%, transparent); margin: 0 0 8px">Movimientos · últimos 7 días</p>
            <svg width="100%" height="48" viewBox="0 0 280 48" preserveAspectRatio="none"><polyline points="0,36 40,30 80,34 120,18 160,24 200,10 240,16 280,6" fill="none" stroke="var(--color-accent)" stroke-width="2"></polyline></svg>
          </div>
          <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 16px; border-top: 1px solid var(--color-divider); padding-top: 14px">
            {activity.map((a) => (
              <div style="display: flex; justify-content: space-between; font-size: 12.5px">
                <span style="color: color-mix(in srgb, var(--color-text) 80%, transparent)">{a.action}</span>
                <span style="font-family: var(--font-mono); color: color-mix(in srgb, var(--color-text) 45%, transparent)">{a.time}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="card elev-sm">
          <span class="card-title" style="font-size: 16px">Acceso por roles</span>
          <p class="card-body" style="opacity: 1; color: color-mix(in srgb, var(--color-text) 70%, transparent); margin-top: 4px">Cada usuario ve solo lo que corresponde a su función.</p>
          <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px">
            <span class="tag tag-accent" style="font-family: var(--font-mono)">Admin</span>
            <span class="tag tag-outline" style="font-family: var(--font-mono)">Ventas</span>
            <span class="tag tag-outline" style="font-family: var(--font-mono)">Bodega</span>
          </div>
        </div>
        <div class="card elev-sm">
          <span class="card-title" style="font-size: 16px">API para integraciones</span>
          <p class="card-body" style="opacity: 1; color: color-mix(in srgb, var(--color-text) 70%, transparent); margin-top: 4px">Cada sistema expone endpoints propios cuando el negocio los necesita.</p>
          <div style="margin-top: 12px; background: var(--color-bg); border-radius: var(--radius-sm); padding: 10px 12px; font-family: var(--font-mono); font-size: 11px; color: color-mix(in srgb, var(--color-text) 70%, transparent)">
            <div>GET /api/inventario/stock</div>
            <div style="color: var(--color-accent); margin-top: 4px">→ 200 {'{ data: [...] }'}</div>
          </div>
        </div>
      </div>

      <span style="display: block; font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent); margin-bottom: 14px">Proyectos destacados</span>
      <h2 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: clamp(24px,3vw,32px); margin: 0 0 36px; max-width: 30ch">Sistemas construidos para resolver problemas reales de negocio.</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px,100%),1fr)); gap: 20px">
        {projects.map((p) => (
          <a href={p.href} class="card elev-sm project-card" style="text-decoration: none; color: inherit; transition: transform .25s ease, box-shadow .25s ease">
            <div style="width: 100%; aspect-ratio: 16/10; border-radius: var(--radius-sm); overflow: hidden">
              <img src={p.imgSrc} alt={p.title} class="img-cover" />
            </div>
            <h3 class="card-title">{p.title}</h3>
            <p class="card-body">{p.summary}</p>
            <div style="display: flex; flex-wrap: wrap; gap: 6px">
              {p.tags.map((t) => (
                <span class="tag tag-accent" style="font-family: var(--font-mono); font-size: 10.5px">{t}</span>
              ))}
            </div>
            <span style="font-size: 13px; font-weight: 500; color: var(--color-accent); margin-top: 4px">Ver caso de estudio →</span>
          </a>
        ))}
      </div>
    </section>

    <section data-reveal="1" style="padding: 64px 0; border-top: 1px solid var(--color-divider)">
      <span style="display: block; font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent); margin: 32px 0 14px">Ingeniería de precisión</span>
      <h2 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: clamp(22px,2.8vw,30px); margin: 0 0 36px; max-width: 30ch">El software empresarial no admite improvisaciones.</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px,100%),1fr)); gap: 28px">
        {principles.map((pr) => (
          <div>
            <div style="width: 34px; height: 34px; border-radius: var(--radius-sm); background: color-mix(in srgb, var(--color-accent) 14%, transparent); display: flex; align-items: center; justify-content: center; color: var(--color-accent); margin-bottom: 14px" set:html={pr.icon} />
            <span style="display: block; font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent); margin-bottom: 10px">{pr.n} · {pr.title}</span>
            <p style="font-size: 14.5px; line-height: 1.6; color: color-mix(in srgb, var(--color-text) 75%, transparent); margin: 0; max-width: 34ch">{pr.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section data-reveal="1" style="padding: 64px 0; border-top: 1px solid var(--color-divider)">
      <span style="display: block; font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent); margin: 32px 0 14px">Comparativa</span>
      <h2 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: clamp(22px,2.8vw,30px); margin: 0 0 32px; max-width: 30ch">¿Por qué un sistema a la medida?</h2>
      <div style="overflow-x: auto">
        <table class="table" style="min-width: 480px">
          <thead>
            <tr>
              <th></th>
              <th style="color: var(--color-accent)">Sistema a la medida</th>
              <th>Hojas de cálculo</th>
              <th>Software genérico</th>
            </tr>
          </thead>
          <tbody>
            {comparison.map((row) => (
              <tr>
                <td style="color: color-mix(in srgb, var(--color-text) 80%, transparent)">{row.label}</td>
                <td style="color: var(--color-accent)">✓</td>
                <td style="color: color-mix(in srgb, var(--color-text) 40%, transparent)">{row.sheets}</td>
                <td style="color: color-mix(in srgb, var(--color-text) 40%, transparent)">{row.generic}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section data-reveal="1" style="padding: 56px 0 88px; display: flex; flex-direction: column; gap: 16px; border-top: 1px solid var(--color-divider)">
      <h2 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: clamp(22px,2.6vw,28px); margin: 32px 0 0; max-width: 26ch">¿Tienes un proceso manual que le está costando tiempo a tu equipo?</h2>
      <p style="font-size: 15px; color: color-mix(in srgb, var(--color-text) 72%, transparent); margin: 0; max-width: 48ch">Cuéntame qué necesitas resolver y evaluamos juntos si puedo ayudarte a construirlo.</p>
      <div>
        <a href="https://wa.me/528117788448" target="_blank" rel="noopener" class="btn btn-primary" style="margin-top: 8px">Escribir por WhatsApp</a>
      </div>
    </section>

  </main>
</Layout>

<style>
  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }
  /* The panel card shares its row with two 1-column cards on wide layouts;
     spanning 2 grid tracks would force a second 300px track even when the
     viewport can't fit it, so the span only applies once two tracks exist. */
  .panel-span {
    grid-column: span 1;
  }
  @media (min-width: 641px) {
    .panel-span {
      grid-column: span 2;
    }
  }
</style>
