---
import Layout from '../../layouts/Layout.astro';
import { blogPosts } from '../../data/blog';

const sorted = [...blogPosts].sort((a, b) => b.date.localeCompare(a.date));
---
<Layout title="Blog — ZA Desarrollo Software" description="Artículos sobre ERPs, sistemas a la medida y software para negocios, explicados sin rollo técnico." footerVariant="full">
  <main>
    <section style="background: radial-gradient(1000px 500px at 92% -20%, color-mix(in srgb, var(--color-accent-900) 55%, transparent), transparent 60%), radial-gradient(720px 460px at 2% 100%, color-mix(in srgb, #6ee7b7 16%, transparent), transparent 65%), var(--color-bg)">
      <div class="wrap" style="padding-block: 32px 24px">
        <span style="display: block; font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent); margin-bottom: 18px">Blog</span>
        <h1 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: clamp(28px,4.4vw,42px); margin: 0; max-width: 22ch">Software para negocios, explicado sin rollo.</h1>
        <p style="font-size: 16px; line-height: 1.6; color: color-mix(in srgb, var(--color-text) 72%, transparent); max-width: 60ch; margin: 20px 0 0">Conceptos, decisiones y aprendizajes sobre sistemas a la medida — para que entiendas qué te conviene antes de invertir en uno.</p>
      </div>
    </section>

    <section style="background: var(--color-surface)">
      <div class="wrap" style="padding-block: 40px 96px; display: flex; flex-direction: column; gap: 24px">
        {sorted.map((post) => (
          <a href={`/blog/${post.slug}`} data-reveal="1" class="card elev-sm hover-lift" style="text-decoration: none; color: inherit; background: var(--color-bg)">
            <div style="display: flex; align-items: center; gap: 10px">
              <span class="tag tag-accent" style="font-family: var(--font-mono)">{post.tag}</span>
              <span style="font-family: var(--font-mono); font-size: 12px; color: color-mix(in srgb, var(--color-text) 50%, transparent)">{new Date(post.date + 'T12:00:00').toLocaleDateString('es-MX', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
            </div>
            <h2 class="card-title" style="font-size: 22px; margin-top: 4px">{post.title}</h2>
            <p class="card-body" style="opacity: 1; color: color-mix(in srgb, var(--color-text) 72%, transparent); max-width: 68ch">{post.excerpt}</p>
            <span style="font-size: 14.5px; font-weight: 500; color: var(--color-accent); margin-top: 4px">Leer artículo →</span>
          </a>
        ))}
      </div>
    </section>
  </main>
</Layout>
