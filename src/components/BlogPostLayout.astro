---
import Layout from '../layouts/Layout.astro';

interface Props {
  pageTitle: string;
  description: string;
  title: string;
  date: string;
  tag: string;
}

const { pageTitle, description, title, date, tag } = Astro.props;

const formattedDate = new Date(date + 'T12:00:00').toLocaleDateString('es-MX', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---
<Layout title={pageTitle} description={description}>
  <main>
    <section style="background: radial-gradient(1000px 500px at 92% -20%, color-mix(in srgb, var(--color-accent-900) 55%, transparent), transparent 60%), radial-gradient(720px 460px at 2% 100%, color-mix(in srgb, #6ee7b7 16%, transparent), transparent 65%), var(--color-bg)">
     <div class="wrap" style="padding-top: 24px">
      <a href="/blog" class="back-link" style="font-size: 13.5px; text-decoration: none; color: color-mix(in srgb, var(--color-text) 60%, transparent)">← Blog</a>

      <header style="padding: 24px 0 40px; max-width: 68ch">
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 16px">
          <span class="tag tag-accent" style="font-family: var(--font-mono)">{tag}</span>
          <span style="font-family: var(--font-mono); font-size: 12.5px; color: color-mix(in srgb, var(--color-text) 50%, transparent)">{formattedDate}</span>
        </div>
        <h1 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: clamp(28px,4vw,42px); line-height: 1.16; margin: 0">{title}</h1>
      </header>
     </div>
    </section>

    <section style="background: var(--color-surface)">
      <div class="wrap" style="padding-block: 48px 64px">
        <div class="prose">
          <slot />
        </div>

        <div class="card" style="margin-top: 56px; flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; background: var(--color-bg); max-width: 68ch">
          <p style="margin: 0; font-size: 15px; color: color-mix(in srgb, var(--color-text) 85%, transparent); max-width: 42ch">¿Tienes un proceso o sistema en mente? Conversemos sin compromiso.</p>
          <a href="/contacto" class="btn btn-primary" style="white-space: nowrap">Hablemos</a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .back-link:hover {
    color: var(--color-accent) !important;
  }

  .prose {
    max-width: 68ch;
    font-size: 16.5px;
    line-height: 1.75;
    color: color-mix(in srgb, var(--color-text) 85%, transparent);
  }
  .prose > * + * {
    margin-top: 20px;
  }
  .prose h2 {
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: 24px;
    line-height: 1.3;
    color: var(--color-text);
    margin-top: 44px;
  }
  .prose h3 {
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: 19px;
    line-height: 1.35;
    color: var(--color-text);
    margin-top: 32px;
  }
  .prose p {
    margin: 0;
  }
  .prose ul,
  .prose ol {
    margin: 0;
    padding-left: 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .prose li {
    padding-left: 4px;
  }
  .prose strong {
    color: var(--color-text);
    font-weight: 600;
  }
  .prose em {
    color: var(--color-accent);
    font-style: normal;
  }
  .prose a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose blockquote {
    margin: 0;
    padding-left: 18px;
    border-left: 2px solid var(--color-accent);
    color: color-mix(in srgb, var(--color-text) 75%, transparent);
  }
</style>
