---
import Layout from '../layouts/Layout.astro';

interface Shot {
  caption: string;
  imgSrc?: string;
  fit?: 'cover' | 'contain';
  position?: string;
  bg?: string;
}
interface ResultItem {
  title: string;
  body: string;
}

interface Props {
  pageTitle: string;
  heading: string;
  intro: string;
  headerTags: string[];
  heroSrc: string;
  heroAlt: string;
  heroBadge: string;
  problem: string;
  solution: string;
  shots: Shot[];
  results: ResultItem[];
  techStack: string[];
  ctaText: string;
}

const {
  pageTitle,
  heading,
  intro,
  headerTags,
  heroSrc,
  heroAlt,
  heroBadge,
  problem,
  solution,
  shots,
  results,
  techStack,
  ctaText,
} = Astro.props;
---
<Layout title={pageTitle}>
  <main>
    <section style="background: radial-gradient(1000px 500px at 92% -20%, color-mix(in srgb, var(--color-accent-900) 55%, transparent), transparent 60%), var(--color-bg)">
     <div class="wrap" style="padding-top: 24px">
      <a href="/proyectos" class="back-link" style="font-size: 13.5px; text-decoration: none; color: color-mix(in srgb, var(--color-text) 60%, transparent)">← Proyectos</a>

      <header style="padding: 24px 0 32px">
        <span style="display: block; font-family: var(--font-mono); font-size: 12.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent); margin-bottom: 16px">Caso de estudio</span>
        <h1 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: clamp(28px,4vw,42px); margin: 0; max-width: 28ch">{heading}</h1>
        <p style="font-size: 16px; color: color-mix(in srgb, var(--color-text) 72%, transparent); max-width: 60ch; margin: 16px 0 0">{intro}</p>
        <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: 20px">
          {headerTags.map((t) => (
            <span class="tag tag-accent" style="font-family: var(--font-mono)">{t}</span>
          ))}
        </div>
      </header>

      <div style="position: relative; width: 100%; aspect-ratio: 16/8; border-radius: var(--radius-lg); overflow: hidden; margin-bottom: 40px">
        <img src={heroSrc} alt={heroAlt} class="img-cover" />
        <span style="position: absolute; top: 16px; left: 16px; pointer-events: none; font-family: var(--font-mono); font-size: 11px; color: var(--color-text); background: color-mix(in srgb, var(--color-bg) 55%, transparent); backdrop-filter: blur(10px); padding: 6px 12px; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent)">{heroBadge}</span>
      </div>
     </div>
    </section>

    <section style="background: var(--color-surface)">
     <div class="stack-mobile wrap" style="display: grid; grid-template-columns: minmax(0,1fr) minmax(min(240px,100%),300px); gap: 56px; padding-block: 56px">
      <div style="display: flex; flex-direction: column; gap: 48px">
        <div>
          <span style="display: block; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent); margin-bottom: 14px">01 · El problema</span>
          <p style="font-size: 16px; line-height: 1.7; color: color-mix(in srgb, var(--color-text) 85%, transparent); margin: 0">{problem}</p>
        </div>
        <div>
          <span style="display: block; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent); margin-bottom: 14px">02 · La solución</span>
          <p style="font-size: 16px; line-height: 1.7; color: color-mix(in srgb, var(--color-text) 85%, transparent); margin: 0 0 28px">{solution}</p>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(220px,100%),1fr)); gap: 20px">
            {shots.map((shot) => (
              <figure style="margin: 0">
                {shot.imgSrc ? (
                  <div style={`position: relative; width: 100%; aspect-ratio: 4/3; border-radius: 10px; overflow: hidden; border: 1px solid var(--color-divider); background: ${shot.bg ?? 'var(--color-bg)'}`}>
                    <img
                      src={shot.imgSrc}
                      alt={shot.caption}
                      style={`width: 100%; height: 100%; display: block; object-fit: ${shot.fit ?? 'cover'}; object-position: ${shot.position ?? 'center'}`}
                    />
                    <span style="position: absolute; bottom: 12px; left: 12px; pointer-events: none; font-family: var(--font-mono); font-size: 11px; color: var(--color-text); background: color-mix(in srgb, var(--color-bg) 55%, transparent); backdrop-filter: blur(10px); padding: 6px 12px; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent)">{shot.caption}</span>
                  </div>
                ) : (
                  <div style="width: 100%; aspect-ratio: 4/3; border-radius: 10px; background: var(--color-bg); border: 1px dashed var(--color-divider); display: flex; align-items: center; justify-content: center; text-align: center; padding: 16px">
                    <span style="font-size: 12.5px; color: color-mix(in srgb, var(--color-text) 45%, transparent)">{shot.caption}</span>
                  </div>
                )}
                {!shot.imgSrc && <figcaption>{shot.caption} (placeholder)</figcaption>}
              </figure>
            ))}
          </div>
        </div>
      </div>

      <aside style="display: flex; flex-direction: column; gap: 28px">
        <span style="display: block; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent)">03 · El resultado</span>
        {results.map((r, i) => (
          <div style={`border-left: 2px solid ${['#9184d9','#6ee7b7','#f5b971'][i % 3]}; padding-left: 16px`}>
            <p style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: 25px; margin: 0 0 6px">{r.title}</p>
            <p style="font-size: 14.5px; line-height: 1.55; color: color-mix(in srgb, var(--color-text) 65%, transparent); margin: 0">{r.body}</p>
          </div>
        ))}
      </aside>
     </div>
    </section>

    <section style="background: linear-gradient(180deg, var(--color-bg), var(--color-section-glow) 260%)">
     <div class="wrap" style="padding-block: 56px 88px">
      <h3 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: 20px; margin: 0 0 20px">Stack técnico</h3>
      <div style="display: flex; flex-wrap: wrap; gap: 8px">
        {techStack.map((t) => (
          <span class="tag tag-neutral" style="font-family: var(--font-mono)">{t}</span>
        ))}
      </div>
      <div class="card" style="margin-top: 40px; flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; background: var(--color-surface)">
        <p style="margin: 0; font-size: 15px; color: color-mix(in srgb, var(--color-text) 85%, transparent); max-width: 40ch">{ctaText}</p>
        <a href="/contacto" class="btn btn-primary" style="white-space: nowrap">Hablemos</a>
      </div>
     </div>
    </section>
  </main>
</Layout>

<style>
  .back-link:hover {
    color: var(--color-accent) !important;
  }
</style>
